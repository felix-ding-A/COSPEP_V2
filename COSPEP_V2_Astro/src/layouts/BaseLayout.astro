---
import "@/styles/global.css";
import { Navbar } from "@/components/layout/navbar";
import { Footer } from "@/components/layout/footer";
import { Toaster } from "@/components/ui/sonner";
import { CookieConsent } from "@/components/CookieConsent";
import { getCategories } from "@/lib/sanity/queries";

interface Props {
	title: string;
	description?: string;
	keywords?: string;
	ogType?: string;
	ogImage?: string;
}

const { 
	title, 
	description = "COSPEP - Pure, Potent & Naturally Derived Bioactive Peptides and Plant Extracts",
	keywords = "COSPEP, Bioactive Peptides, Botanical Extracts, Plant Extracts China, Custom Synthesis, cGMP Manufacturing",
	ogType = "website",
	ogImage = "/og-image.webp"
} = Astro.props;

const lang = "en";
const categories = await getCategories();
const dir = "ltr";


const absoluteOgImage = new URL(ogImage, Astro.site).href;
---

<!doctype html>
<html lang={lang} dir={dir} class="dark">
	<head>
		<!-- Google Tag Manager -->
		<script is:inline>
			// Consent Mode v2: default denied until user accepts
			window.dataLayer = window.dataLayer || [];
			function gtag(){dataLayer.push(arguments);}
			gtag('consent', 'default', {
				ad_storage: 'denied',
				analytics_storage: 'denied',
				ad_user_data: 'denied',
				ad_personalization: 'denied',
				wait_for_update: 500
			});
			// Standard GTM loader (IIFE)
			(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
			new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
			j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
			'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
			})(window,document,'script','dataLayer','GTM-TZP98ZV5');
		</script>
		<!-- End Google Tag Manager -->
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/webp" href="/favicon.webp" />
		<meta name="generator" content={Astro.generator} />
		<meta name="theme-color" content="#0A0E0D" />
		
		<!-- Primary Meta Tags -->
		<title>{title}</title>
		<meta name="title" content={title} />
		<meta name="description" content={description} />
		<meta name="keywords" content={keywords} />
		

		
		<link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />

		<!-- Open Graph / Facebook -->
		<meta property="og:type" content={ogType} />
		<meta property="og:url" content={Astro.url} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={absoluteOgImage} />

		<!-- Twitter -->
		<meta property="twitter:card" content="summary_large_image" />
		<meta property="twitter:url" content={Astro.url} />
		<meta property="twitter:title" content={title} />
		<meta property="twitter:description" content={description} />
		<meta property="twitter:image" content={absoluteOgImage} />
	</head>
	<body class="min-h-screen bg-[#0A0E0D] font-sans antialiased text-white flex flex-col">
		<!-- Google Tag Manager (noscript) -->
		<noscript>
			<iframe
				src="https://www.googletagmanager.com/ns.html?id=GTM-TZP98ZV5"
				height="0"
				width="0"
				style="display:none;visibility:hidden"
			></iframe>
		</noscript>
		<!-- End Google Tag Manager (noscript) -->
		<CookieConsent client:load />
		<Toaster client:idle />
		<Navbar client:load lang={lang} categories={categories} />
		<main class="flex-grow">
			<slot />
		</main>
		<Footer client:visible lang={lang} />
	</body>
</html>

<style is:global>
	:root {
		--font-sans: "Inter", system-ui, sans-serif;
	}
</style>
