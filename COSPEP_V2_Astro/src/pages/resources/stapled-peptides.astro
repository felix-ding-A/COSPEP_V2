</BaseLayout>

<style>
    .custom-scrollbar::-webkit-scrollbar {
        width: 4px;
    }
    .custom-scrollbar::-webkit-scrollbar-track {
        background: transparent;
    }
    .custom-scrollbar::-webkit-scrollbar-thumb {
        background-color: #374151;
        border-radius: 20px;
    }

    .nav-link.active {
        color: #B8FF00 !important;
        font-weight: 700;
        border-left-color: #B8FF00;
        background-color: rgba(184, 255, 0, 0.05);
    }

    .chart-container {
        position: relative;
        width: 100%;
        height: 350px;
    }

    .amino-acid {
        width: 40px;
        height: 40px;
        border-radius: 50%;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-weight: 800;
        font-size: 0.85rem;
        z-index: 10;
        position: relative;
        box-shadow: 0 4px 10px rgba(0, 0, 0, 0.5);
    }

    .peptide-chain {
        position: relative;
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 40px 20px;
    }

    .staple-bridge {
        position: absolute;
        height: 45px;
        border: 4px solid #B8FF00;
        border-bottom: none;
        border-radius: 40px 40px 0 0;
        top: 15px;
        z-index: 5;
        box-shadow: inset 0 6px 10px -4px rgba(184,255,0,0.3);
    }

    .fade-in-section {
        opacity: 0;
        transform: translateY(20px);
        transition: opacity 0.8s ease-out, transform 0.8s ease-out;
    }

    .fade-in-section.is-visible {
        opacity: 1;
        transform: none;
    }

    .fade-in {
        animation: fadeIn 0.5s ease-out forwards;
    }

    @keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(15px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
</style>

<script is:inline>
    const contentData = {
        stability: {
            title: "Proteolytic Resistance",
            stat: ">12x Increase",
            desc: "The hydrocarbon staple acts as a physical shield, preventing proteases from accessing and cleaving the peptide backbone, extending half-life to hours or days.",
            takeaway: "Allows for practical dosing schedules in clinical settings.",
            chartConfig: {
                labels: ['Unstapled', 'Stapled'],
                data: [15, 180],
                yAxisLabel: 'Half-Life (Minutes)',
                bgColor: ['rgba(255, 255, 255, 0.1)', '#B8FF00'],
                borderColor: ['rgba(255, 255, 255, 0.2)', '#D4FF5C'],
                title: 'In-vivo Stability Comparison'
            }
        },
        permeability: {
            title: "Intracellular Permeability",
            stat: "60% Cellular Uptake",
            desc: "The hydrophobic nature of the hydrocarbon staple masks polar groups and facilitates active transport into the cell interior.",
            takeaway: "Opens the door to targeting intracellular protein interactions.",
            chartConfig: {
                labels: ['Unstapled', 'Stapled'],
                data: [2, 65],
                yAxisLabel: 'Cellular Uptake (%)',
                bgColor: ['rgba(255, 255, 255, 0.1)', '#0ea5e9'],
                borderColor: ['rgba(255, 255, 255, 0.2)', '#38bdf8'],
                title: 'Membrane Penetration Efficiency'
            }
        },
        affinity: {
            title: "Target Binding Affinity",
            stat: "10-50x Tighter Binding",
            desc: "A stapled peptide is pre-folded. This 'entropic advantage' means binding is immediate, significantly lowering the Dissociation Constant (Kd).",
            takeaway: "Lower Kd means stronger binding, requiring lower drug doses.",
            chartConfig: {
                labels: ['Unstapled', 'Stapled'],
                data: [450, 15],
                yAxisLabel: 'Kd (nM) - Lower is Better',
                bgColor: ['rgba(255, 255, 255, 0.1)', '#8b5cf6'],
                borderColor: ['rgba(255, 255, 255, 0.2)', '#a78bfa'],
                title: 'Binding Strength (Lower = Stronger)'
            }
        }
    };

    let myChart = null;

    function initChart() {
        const canvas = document.getElementById('mainChart');
        if (!canvas) return;
        const ctx = canvas.getContext('2d');

        Chart.defaults.font.family = 'Inter, system-ui, sans-serif';
        Chart.defaults.color = '#9ca3af';

        myChart = new Chart(ctx, {
            type: 'bar',
            data: {
                labels: contentData.stability.chartConfig.labels,
                datasets: [{
                    label: 'Metric Value',
                    data: contentData.stability.chartConfig.data,
                    backgroundColor: contentData.stability.chartConfig.bgColor,
                    borderColor: contentData.stability.chartConfig.borderColor,
                    borderWidth: 1,
                    borderRadius: 8,
                    borderSkipped: false,
                    barPercentage: 0.6
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { display: false },
                    title: {
                        display: true,
                        text: contentData.stability.chartConfig.title,
                        font: { size: 16, weight: 'bold' },
                        color: '#fff',
                        padding: { bottom: 20 }
                    },
                    tooltip: {
                        backgroundColor: '#0F1612',
                        titleColor: '#B8FF00',
                        bodyColor: '#fff',
                        borderColor: 'rgba(255,255,255,0.1)',
                        borderWidth: 1,
                        padding: 12,
                        displayColors: false
                    }
                },
                scales: {
                    y: {
                        beginAtZero: true,
                        title: {
                            display: true,
                            text: contentData.stability.chartConfig.yAxisLabel,
                            color: '#9ca3af'
                        },
                        grid: { color: 'rgba(255, 255, 255, 0.05)', drawBorder: false }
                    },
                    x: {
                        grid: { display: false, drawBorder: false },
                        ticks: { color: '#e5e7eb' }
                    }
                }
            }
        });
    }

    window.updateDashboard = function(viewId) {
        const btns = document.querySelectorAll('.data-toggle-btn');
        btns.forEach(btn => {
            btn.className = 'data-toggle-btn px-6 py-3 rounded-full font-medium text-sm transition-all bg-transparent text-gray-400 border border-white/20 hover:bg-white/5 hover:text-white';
        });
        const activeBtn = document.getElementById(`btn-${viewId}`);
        activeBtn.className = 'data-toggle-btn px-6 py-3 rounded-full font-bold text-sm transition-all bg-[#B8FF00] text-[#0A0E0D] shadow-[0_0_15px_rgba(184,255,0,0.2)]';

        const data = contentData[viewId];
        document.getElementById('panel-title').innerText = data.title;
        document.getElementById('panel-stat').innerText = data.stat;
        document.getElementById('panel-desc').innerText = data.desc;
        document.getElementById('panel-takeaway').innerText = data.takeaway;

        if (myChart) {
            myChart.data.labels = data.chartConfig.labels;
            myChart.data.datasets[0].data = data.chartConfig.data;
            myChart.data.datasets[0].backgroundColor = data.chartConfig.bgColor;
            myChart.data.datasets[0].borderColor = data.chartConfig.borderColor;
            myChart.options.scales.y.title.text = data.chartConfig.yAxisLabel;
            myChart.options.plugins.title.text = data.chartConfig.title;
            myChart.update();
        }
    }

    function initScrollEffects() {
        // 1. Fade In on Scroll
        const faders = document.querySelectorAll('.fade-in-section');
        const appearOptions = { threshold: 0.15, rootMargin: "0px 0px -50px 0px" };
        const appearOnScroll = new IntersectionObserver((entries, observer) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    entry.target.classList.add('is-visible');
                    observer.unobserve(entry.target);
                }
            });
        }, appearOptions);
        faders.forEach(fader => appearOnScroll.observe(fader));

        // 2. Scrollspy for Sidebar TOC
        const sections = document.querySelectorAll('section');
        const navLinks = document.querySelectorAll('#toc a');
        window.addEventListener('scroll', () => {
            let current = '';
            const scrollPos = window.scrollY + 120;
            sections.forEach(section => {
                const sectionTop = section.offsetTop;
                const sectionHeight = section.clientHeight;
                if (scrollPos >= sectionTop && scrollPos < (sectionTop + sectionHeight)) {
                    current = section.getAttribute('id');
                }
            });
            navLinks.forEach(link => {
                link.classList.remove('active');
                if (link.getAttribute('href') === `#${current}`) {
                    link.classList.add('active');
                }
            });
        });
    }

    document.addEventListener('DOMContentLoaded', () => {
        initChart();
        initScrollEffects();
    });
    document.addEventListener('astro:page-load', () => {
        initChart();
        initScrollEffects();
    });
</script>
