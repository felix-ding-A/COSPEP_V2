---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { useTranslations } from '@/lib/i18n';
import { getProductBySlug } from "@/lib/sanity/queries";
import { Badge } from "@/components/ui/badge";
import { Truck } from "lucide-react";
import { ImageZoom } from "@/components/products/image-zoom";
import { ProductActions } from "@/components/products/product-actions";
import { ProductImageCTAButtons } from "@/components/products/product-image-cta-buttons";
import { ProductDetailClient } from "@/components/products/product-detail-client";
import { SITE_CONFIG } from "@/lib/config";
import { Breadcrumbs } from "@/components/Breadcrumbs";

const { slug } = Astro.params;
const lang = 'en';
const t = useTranslations(lang);

if (!slug) {
    return Astro.redirect(`/products`);
}

const product = await getProductBySlug(slug);

if (!product) {
    return Astro.redirect('/404');
}

const isReadyStock = product.stockStatus === 'Ready to Ship';

const title = product.seoTitle || t('meta.productDetail.titleFallback').replace('{name}', product.name);
const description = product.seoDesc || t('meta.productDetail.fallback').replace('{name}', product.name);

// JSON-LD Structured Data
const jsonLd = {
    "@context": "https://schema.org",
    "@graph": [
        {
            "@type": "BreadcrumbList",
            "itemListElement": [
                { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://cospep.com" },
                { "@type": "ListItem", "position": 2, "name": "Products", "item": "https://cospep.com/products" },
                { "@type": "ListItem", "position": 3, "name": product.name }
            ]
        },
        {
            "@type": "Product",
            "name": product.name,
            "image": product.imageUrl,
            "description": product.description || product.seoDesc || `Wholesale ${product.name}`,
            "sku": product.casNumber,
            "mpn": product.casNumber,
            "brand": { "@type": "Brand", "name": "COSPEP" },
            "offers": {
                "@type": "Offer",
                "url": `https://cospep.com/products/${product.slug.current}`,
                "availability": isReadyStock ? "https://schema.org/InStock" : "https://schema.org/PreOrder",
                "priceCurrency": "USD",
                "price": "0.00",
                "priceValidUntil": "2025-12-31"
            }
        }
    ]
};
---

<BaseLayout title={title} description={description}>
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <div class="min-h-screen bg-[#0A0E0D]">
        {/* Breadcrumb */}
        <div class="bg-gradient-to-b from-[#0F1612] to-[#0A0E0D]">
            <Breadcrumbs title={product.name} pathname={Astro.url.pathname} />
        </div>

        <div class="container mx-auto px-4 md:px-6 py-10">
            {/* Main Product Section */}
            <div class="grid lg:grid-cols-2 gap-8 lg:gap-12 mb-16">
                {/* Left: Product Image */}
                <div>
                    <div class="w-full aspect-[4/3] glass rounded-2xl overflow-hidden flex items-center justify-center border border-white/10 relative group">
                        {product.imageUrl ? (
                            <ImageZoom
                                src={product.imageUrl}
                                alt={product.name}
                                client:load
                            />
                        ) : (
                            <span className="text-gray-500 text-lg">{t('common.noImage') || 'No Image Available'}</span>
                        )}

                        {/* Stock Badge Overlay */}
                        {isReadyStock && (
                            <div className="absolute top-4 right-4 z-10">
                                <Badge className="bg-green-500/90 backdrop-blur-sm text-white border-none px-3 py-1">
                                    <span className="relative flex h-2 w-2 mr-2">
                                        <span className="animate-ping absolute inline-flex h-full w-full rounded-full bg-green-300 opacity-75"></span>
                                        <span className="relative inline-flex rounded-full h-2 w-2 bg-green-200"></span>
                                    </span>
                                    {t('common.inStock') || 'In Stock'}
                                </Badge>
                            </div>
                        )}

                        {/* Action Icons */}
                        <div className="absolute inset-0 pointer-events-none group-hover:pointer-events-auto">
                           <ProductActions
                                client:load
                                productSlug={product.slug.current}
                                productName={product.name}
                                productDescription={product.description}
                            />
                        </div>
                    </div>

                    {/* CTA Buttons Below Image */}
                    <ProductImageCTAButtons client:load />
                </div>

                {/* Right: Product Info */}
                <div class="space-y-6">
                    {/* Title & Basic Info */}
                    <div>
                        <h1 class="text-4xl lg:text-5xl font-bold text-white mb-4 leading-tight">
                            {product.name}
                        </h1>

                        <div class="flex flex-wrap gap-4 text-gray-300">
                            {product.latinName && (
                                <span class="italic text-lg">{product.latinName}</span>
                            )}
                        </div>

                        {/* Key Specs Grid */}
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 mt-6">
                            <div class="glass rounded-lg p-4 border border-white/10">
                                <div class="text-sm text-gray-400 mb-1">CAS Number</div>
                                <div class="text-lg font-semibold text-white font-mono">
                                    {product.casNumber || 'N/A'}
                                </div>
                            </div>
                            {product.purity && (
                                <div class="glass rounded-lg p-4 border border-white/10">
                                    <div class="text-sm text-gray-400 mb-1">{t('common.purity') || 'Purity'}</div>
                                    <div class="text-lg font-semibold text-[#B8FF00]">
                                        {product.purity}
                                    </div>
                                </div>
                            )}
                            {product.inciName && (
                                <div class="glass rounded-lg p-4 border border-white/10 sm:col-span-2">
                                    <div class="text-sm text-gray-400 mb-1">{t('common.inciName') || 'INCI Name'}</div>
                                    <div class="text-lg font-semibold text-white">
                                        {product.inciName}
                                    </div>
                                </div>
                            )}
                        </div>
                    </div>

                    {/* Stock Status */}
                    {isReadyStock && (
                        <div class="glass-strong rounded-lg p-4 border border-green-500/20">
                            <div class="flex items-center gap-3">
                                <div class="w-12 h-12 rounded-full bg-green-500/10 flex items-center justify-center">
                                    <Truck className="w-6 h-6 text-green-400" />
                                </div>
                                <div>
                                    <div class="font-semibold text-white">{t('common.readyToShip') || 'Ready to Ship'}</div>
                                    <div class="text-sm text-gray-400">
                                        Available from <span class="text-[#B8FF00]">{SITE_CONFIG.warehouse}</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    )}

                    {/* Categories */}
                    {product.categories && product.categories.length > 0 && (
                        <div>
                            <div class="text-sm text-gray-400 mb-2">{t('common.categories') || 'Categories'}</div>
                            <div class="flex flex-wrap gap-2">
                                {product.categories.map((cat: any) => (
                                    <Badge
                                        variant="outline"
                                        className="border-white/20 text-gray-300 hover:border-[#B8FF00] hover:text-[#B8FF00] transition-colors cursor-pointer"
                                    >
                                        {cat.title}
                                    </Badge>
                                ))}
                            </div>
                        </div>
                    )}

                    {/* Product Info Grid */}
                    <div class="glass-strong rounded-xl p-6 border border-white/10 space-y-3">
                        <div class="flex justify-between py-2 border-b border-white/10">
                            <span class="text-gray-400">{t('common.moq') || 'MOQ'}</span>
                            <span class="text-white font-medium">{product.moq || SITE_CONFIG.moq}</span>
                        </div>
                        <div class="flex justify-between py-2 border-b border-white/10">
                            <span class="text-gray-400">{t('common.leadTime') || 'Lead Time'}</span>
                            <span class="text-white font-medium">{product.leadTime || SITE_CONFIG.leadTime}</span>
                        </div>
                        {product.grade && (
                            <div class="flex justify-between py-2 border-b border-white/10">
                                <span class="text-gray-400">{t('common.grade') || 'Grade'}</span>
                                <span class="text-white font-medium">{product.grade}</span>
                            </div>
                        )}
                        <div class="flex justify-between py-2">
                            <span class="text-gray-400">{t('common.documents') || 'Documents'}</span>
                            <span class="text-white font-medium">{SITE_CONFIG.documents.join(", ")}</span>
                        </div>
                    </div>
                </div>
            </div>

            {/* Client Components (Tabs + Contact Form) */}
            <ProductDetailClient 
                client:load 
                product={product} 
                siteConfig={SITE_CONFIG} 
            />
        </div>
    </div>
</BaseLayout>
