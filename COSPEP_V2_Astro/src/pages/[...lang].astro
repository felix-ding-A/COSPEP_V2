---
import BaseLayout from '../layouts/BaseLayout.astro';
import { useTranslations } from '../lib/i18n';
import { HeroSection } from '@/components/home/hero-section';
import { TrustStatsBar } from '@/components/home/trust-stats-bar';
import { ProductEcosystem } from '@/components/home/product-ecosystem';
import { PeptidePromo } from '@/components/home/peptide-promo';
import { ManufacturingSection } from '@/components/home/manufacturing-section';
import { NewsBlogs } from '@/components/home/news-blogs';
import { client } from "@/lib/sanity";
import { getSiteSettings } from "@/lib/sanity/queries";

export function getStaticPaths() {
  return [
    { params: { lang: undefined } },
    { params: { lang: 'es' } },
    { params: { lang: 'ru' } },
    { params: { lang: 'ar' } },
  ];
}

const { lang: langParam } = Astro.params;
const lang = langParam || 'en';
const t = useTranslations(lang as any);

const settings = await client.fetch(getSiteSettings);

// SEO Metadata
const baseUrl = 'https://cospep.com';
const currentUrl = lang === 'en' ? baseUrl : `${baseUrl}/${lang}`;
const title = "Leading Chinese Peptide Manufacturer & Plant Extracts Supplier | COSPEP";
const description = "Best Chinese peptide suppliers for global B2B sourcing. COSPEP offers high-purity bioactive peptides, bulk plant extracts, and custom synthesis manufacturing with worldwide shipping.";
const keywords = "China Peptide Suppliers, Chinese Peptide Manufacturer, Bioactive Peptides, Botanical Extracts Supplier, Bulk Peptides China, Custom Synthesis, Pharmaceutical Intermediates";

const jsonLd = {
    "@context": "https://schema.org",
    "@type": "Organization",
    "name": "COSPEP",
    "url": "https://cospep.com",
    "logo": "https://cospep.com/logo.webp",
    "description": settings?.heroSubtitle || "Pure, Potent & Naturally Derived Ingredients",
    "address": {
        "@type": "PostalAddress",
        "streetAddress": settings?.address || "Xi'an International Trade & Logistics Park"
    },
    "contactPoint": {
        "@type": "ContactPoint",
        "telephone": settings?.whatsapp || "",
        "contactType": "customer service",
        "email": settings?.contactEmail
    },
    "sameAs": [
        "https://www.linkedin.com/company/cospep",
    ]
};
---

<BaseLayout title={title} description={description} keywords={keywords}>
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    
    <main class="flex min-h-screen flex-col">
        <HeroSection client:load />
        <TrustStatsBar client:visible />
        <PeptidePromo client:visible />
        <ProductEcosystem client:visible />
        <ManufacturingSection client:visible />
        <NewsBlogs client:visible />
    </main>
</BaseLayout>
