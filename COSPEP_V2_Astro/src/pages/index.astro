---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { useTranslations } from '@/lib/i18n';
import { HeroSection } from '@/components/home/hero-section';
import TrustStatsBar from '@/components/home/TrustStatsBar.astro';
import PeptidePromo from '@/components/home/PeptidePromo.astro';
import ProductEcosystem from '@/components/home/ProductEcosystem.astro';
import ManufacturingSection from '@/components/home/ManufacturingSection.astro';
import NewsBlogs from '@/components/home/NewsBlogs.astro';
import { client } from "@/lib/sanity";
import { getSiteSettings } from "@/lib/sanity/queries";

const lang = 'en';
const t = useTranslations(lang);

const settings = await client.fetch(getSiteSettings);

// SEO Metadata
const baseUrl = 'https://cospep.com';
const currentUrl = baseUrl;
const title = t('meta.home.title');
const description = t('meta.home.description');
const keywords = "China Peptide Suppliers, Chinese Peptide Manufacturer, Bioactive Peptides, Botanical Extracts Supplier, Bulk Peptides China, Custom Synthesis, Pharmaceutical Intermediates";

const jsonLd = {
    "@context": "https://schema.org",
    "@type": "Organization",
    "name": "COSPEP",
    "url": "https://cospep.com",
    "logo": "https://cospep.com/logo.webp",
    "description": settings?.heroSubtitle || "Pure, Potent & Naturally Derived Ingredients",
    "address": {
        "@type": "PostalAddress",
        "streetAddress": settings?.address || "Xi'an International Trade & Logistics Park",
        "addressLocality": "Xi'an",
        "addressRegion": "Shaanxi",
        "postalCode": "710000",
        "addressCountry": "CN"
    },
    "contactPoint": {
        "@type": "ContactPoint",
        "telephone": settings?.whatsapp || "",
        "contactType": "customer service",
        "email": settings?.contactEmail
    },
    "sameAs": [
        "https://www.linkedin.com/company/cospep",
    ]
};
---

<BaseLayout title={title} description={description} keywords={keywords}>
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    
    <main class="flex min-h-screen flex-col">
        <HeroSection client:idle lang={lang} />
        <TrustStatsBar lang={lang} />
        <PeptidePromo lang={lang} />
        <ProductEcosystem lang={lang} />
        <ManufacturingSection lang={lang} />
        <NewsBlogs lang={lang} />
    </main>
</BaseLayout>
