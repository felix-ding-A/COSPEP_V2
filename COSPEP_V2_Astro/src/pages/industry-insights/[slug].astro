---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { useTranslations } from '../../../lib/i18n';
import { getBlogPostBySlug } from "@/lib/sanity/queries";
import { PortableText } from "@portabletext/react";
import { urlFor } from "@/lib/sanity";
import { Breadcrumbs } from "@/components/Breadcrumbs";
import { blogPortableTextComponents } from "@/components/blog/blog-portable-text-components";
import { FaqAccordion } from "@/components/blog/FaqAccordion";

const { slug, lang: langParam } = Astro.params;
const lang = langParam || 'en';
const t = useTranslations(lang as any);

if (!slug) {
    return Astro.redirect(`/${lang}/industry-insights`);
}

const post = await getBlogPostBySlug(slug);

if (!post) {
    return Astro.redirect('/404');
}

// Pre-fetch Google Sheets data during SSR
if (post.body && Array.isArray(post.body)) {
    for (const block of post.body) {
        if (block._type === 'googleSheet' && block.url) {
            try {
                const res = await fetch(block.url);
                if (res.ok) {
                    const text = await res.text();
                    // More robust CSV parsing
                    const rows = text.split(/\r?\n/)
                        .map(row => {
                            // Split by comma but respect quoted strings (if any)
                            const regex = /,(?=(?:(?:[^"]*"){2})*[^"]*$)/;
                            return row.split(regex).map(cell => 
                                cell.trim().replace(/^"(.*)"$/, '$1').trim()
                            );
                        })
                        .filter(row => row.some(cell => cell !== ''));

                    // Auto-crop extra empty columns that Google Sheets might export
                    if (rows.length > 0) {
                        let maxCols = 0;
                        rows.forEach(row => {
                            for (let i = row.length - 1; i >= 0; i--) {
                                if (row[i] !== '') {
                                    maxCols = Math.max(maxCols, i + 1);
                                    break;
                                }
                            }
                        });
                        block.sheetData = rows.map(row => row.slice(0, maxCols));
                    }
                }
            } catch (err) {
                console.error('Failed to pre-fetch Google Sheet data on SSR:', err);
            }
        }
    }
}

const faqTitle = lang === 'es' ? 'Preguntas Frecuentes' : (lang === 'ru' ? 'Часто задаваемые вопросы' : 'Frequently Asked Questions');

const title = post.seoTitle || t('meta.blogDetail.titleFallback').replace('{title}', post.title);
const description = post.seoDescription || post.excerpt || t('meta.blogDetail.fallback').replace('{title}', post.title);

// JSON-LD
const faqSchema = post.faqs && post.faqs.length > 0 ? {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": post.faqs.map((faq: any) => ({
        "@type": "Question",
        "name": faq.question,
        "acceptedAnswer": {
            "@type": "Answer",
            "text": faq.answer
        }
    }))
} : null;

const articleSchema = {
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    "headline": post.title,
    "image": post.mainImage ? post.mainImage : undefined,
    "datePublished": post.publishedAt,
    "dateModified": post._updatedAt || post.publishedAt,
    "author": {
        "@type": "Organization",
        "name": "COSPEP Team"
    },
    "publisher": {
        "@type": "Organization",
        "name": "COSPEP",
        "logo": {
            "@type": "ImageObject",
            "url": "https://cospep.com/logo.webp"
        }
    },
    "description": post.seoDescription || post.excerpt
};
---

<BaseLayout title={title} description={description}>
    {faqSchema && <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />}
    <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />

    <main class="min-h-screen bg-[#0A0E0D]">
        <div class="bg-gradient-to-b from-[#0F1612] to-[#0A0E0D]">
            <Breadcrumbs title={post.title} pathname={Astro.url.pathname} />
        </div>

        <article class="container mx-auto px-4 py-12 md:px-6 lg:py-16">
            <div class="mx-auto max-w-3xl">
                {/* Hero Image */}
                {post.mainImage && (
                    <div class="relative aspect-video w-full overflow-hidden rounded-2xl mb-10 border border-white/10">
                        <img
                            src={post.mainImage}
                            alt={post.title || "Blog post image"}
                            class="object-cover w-full h-full"
                        />
                        <div class="absolute inset-0 bg-gradient-to-t from-[#0A0E0D] to-transparent opacity-40"></div>
                    </div>
                )}

                {/* Meta */}
                {post.publishedAt && (
                    <div class="mb-6 text-sm text-[#B8FF00] font-medium tracking-wide uppercase">
                        {new Date(post.publishedAt).toLocaleDateString(
                            lang === 'cn' ? 'zh-CN' : (lang === 'es' ? 'es-ES' : 'en-US'),
                            {
                                year: 'numeric',
                                month: 'long',
                                day: 'numeric'
                            }
                        )}
                    </div>
                )}

                {/* Title */}
                <h1 class="text-4xl md:text-5xl lg:text-6xl font-extrabold tracking-tight mb-8 text-white leading-tight">
                    {post.title || "Untitled Post"}
                </h1>

                {/* Excerpt */}
                {post.excerpt && (
                    <p class="text-xl text-gray-400 mb-10 italic border-l-4 border-[#B8FF00] pl-6 py-2 leading-relaxed">
                        {post.excerpt}
                    </p>
                )}

                {/* Body */}
                {post.body && Array.isArray(post.body) && post.body.length > 0 && (
                    <div class="prose prose-lg prose-invert max-w-none text-gray-300 leading-relaxed
                        prose-headings:text-white prose-headings:font-bold
                        prose-a:text-[#B8FF00] prose-a:no-underline hover:prose-a:underline
                        prose-strong:text-white prose-blockquote:border-[#B8FF00]
                        prose-img:rounded-2xl prose-img:border prose-img:border-white/10">
                        <PortableText value={post.body} components={blogPortableTextComponents} />
                    </div>
                )}

                {/* FAQs Section - Collapsible */}
                {post.faqs && post.faqs.length > 0 && (
                    <div class="mt-16 border-t border-white/10 pt-16">
                        <h2 class="text-3xl font-bold mb-8 text-white flex items-center gap-4">
                            <span class="w-8 h-1 bg-[#B8FF00] rounded-full"></span>
                            {faqTitle}
                        </h2>
                        <FaqAccordion client:load faqs={post.faqs} />
                    </div>
                )}
            </div>
        </article>
    </main>
</BaseLayout>
