---
import { ArrowRight } from "lucide-astro";
import { Link } from "@/lib/navigation";
import { useTranslations } from "@/lib/i18n";

const { lang = "en" } = Astro.params;
const t = useTranslations(lang as any);

const products = [
    {
        title: t('home.products.items.0.title'),
        description: t('home.products.items.0.description'),
        image: "/images/product-peptides.webp",
        link: "/products?category=Peptide"
    },
    {
        title: t('home.products.items.1.title'),
        description: t('home.products.items.1.description'),
        image: "/images/product-intermediates.webp",
        link: "/products?category=Pharmaceutical%20Intermediates"
    },
    {
        title: t('home.products.items.2.title'),
        description: t('home.products.items.2.description'),
        image: "/images/product-plants.webp",
        link: "/products?category=Natural%20Plant%20Extracts"
    },
    {
        title: t('home.products.items.3.title'),
        description: t('home.products.items.3.description'),
        image: "/images/product-supplements.webp",
        link: "/custom-manufacturing"
    }
];
---

<section class="py-24 bg-gradient-to-b from-background to-[#0F1612]" id="product-ecosystem-section">
    <div class="max-w-7xl mx-auto px-6">
        {/* Section Header */}
        <div class="text-center mb-16 ecosystem-header opacity-0 translate-y-4 transition-all duration-700">
            <span class="inline-block px-4 py-2 rounded-full border border-[#B8FF00]/20 text-[#B8FF00] text-sm font-medium mb-4 uppercase tracking-wider">
                {t('home.products.badge')}
            </span>
            <h2 class="text-4xl md:text-5xl font-bold text-white mb-4">
                {t('home.products.title')}
            </h2>
            <p class="text-gray-400 text-lg max-w-2xl mx-auto">
                {t('home.products.description')}
            </p>
        </div>

        {/* Product Grid */}
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            {products.map((product, index) => (
                <div 
                    class="ecosystem-item opacity-0 translate-y-8 transition-all duration-700"
                    style={`transition-delay: ${index * 100}ms`}
                >
                    <Link href={product.link} class="group block h-full">
                        <div class="relative h-80 rounded-2xl overflow-hidden">
                            {/* Background Image */}
                            <div class="absolute inset-0 h-full w-full">
                                <img
                                    src={product.image}
                                    alt={product.title}
                                    class="object-cover transition-transform duration-500 group-hover:scale-110 h-full w-full"
                                    loading="lazy"
                                />
                                {/* Gradient Overlay */}
                                <div class="absolute inset-0 bg-gradient-to-t from-[#0A0E0D] via-[#0A0E0D]/60 to-transparent"></div>
                            </div>

                            {/* Content */}
                            <div class="relative h-full flex flex-col justify-end p-8">
                                <div class="glass-subtle rounded-xl p-6 group-hover:bg-white/10 transition-all duration-300">
                                    <h3 class="text-2xl font-bold text-white mb-2 group-hover:text-[#B8FF00] transition-colors">
                                        {product.title}
                                    </h3>
                                    <p class="text-gray-300 mb-4">
                                        {product.description}
                                    </p>
                                    <div class="flex items-center text-[#B8FF00] font-medium group-hover:translate-x-2 transition-transform">
                                        {t('common.learnMore')}
                                        <ArrowRight class="ml-2 w-5 h-5" />
                                    </div>
                                </div>
                            </div>
                        </div>
                    </Link>
                </div>
            ))}
        </div>
    </div>
</section>

<script>
    const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
            if (entry.isIntersecting) {
                entry.target.querySelectorAll('.ecosystem-header, .ecosystem-item').forEach(el => {
                    el.classList.remove('opacity-0', 'translate-y-4', 'translate-y-8');
                    el.classList.add('opacity-100', 'translate-y-0');
                });
                observer.unobserve(entry.target);
            }
        });
    }, { threshold: 0.1 });

    const section = document.getElementById('product-ecosystem-section');
    if (section) {
        observer.observe(section);
    }
</script>

<style>
    .ecosystem-header, .ecosystem-item {
        transition-property: transform, opacity;
    }
</style>
