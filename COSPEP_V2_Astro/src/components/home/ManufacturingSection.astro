---
import { Check, Sparkles, Award } from "lucide-astro";
import { Button } from "@/components/ui/button";
import { Link } from "@/lib/navigation";
import { useTranslations } from "@/lib/i18n";

const { lang = "en" } = Astro.params;
const t = useTranslations(lang as any);

const features = [
    t('home.manufacturing.features.0'),
    t('home.manufacturing.features.1'),
    t('home.manufacturing.features.2'),
    t('home.manufacturing.features.3'),
    t('home.manufacturing.features.4'),
    t('home.manufacturing.features.5')
];
---

<section class="py-24 bg-[#0A0E0D] overflow-hidden" id="manufacturing-section">
    <div class="max-w-7xl mx-auto px-6">
        {/* Section Badge */}
        <div class="mb-16 fade-up opacity-0 translate-y-4 transition-all duration-700">
            <span class="inline-block px-4 py-2 rounded-full border border-[#B8FF00]/20 text-[#B8FF00] text-sm font-medium uppercase tracking-wider">
                {t('home.manufacturing.badge')}
            </span>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
            {/* Left Content */}
            <div class="fade-left opacity-0 -translate-x-8 transition-all duration-700">
                <h2 class="text-4xl md:text-5xl font-bold text-white mb-6 leading-tight whitespace-pre-line">
                    {t('home.manufacturing.title')}
                </h2>
                <p class="text-gray-400 text-lg mb-8 leading-relaxed">
                    {t('home.manufacturing.description')}
                </p>

                {/* Features List */}
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-8">
                    {features.map((feature, index) => (
                        <div 
                            class="flex items-start gap-3 fade-in opacity-0 transition-all duration-500"
                            style={`transition-delay: ${300 + index * 100}ms`}
                        >
                            <div class="mt-1 w-5 h-5 rounded-full bg-[#B8FF00]/10 flex items-center justify-center flex-shrink-0">
                                <Check class="w-3 h-3 text-[#B8FF00]" />
                            </div>
                            <span class="text-gray-300">{feature}</span>
                        </div>
                    ))}
                </div>

                {/* CTA Button */}
                <Button
                    size="lg"
                    className="bg-[#B8FF00] hover:bg-[#A3E600] text-[#0A0E0D] font-semibold px-8"
                >
                    <Link href="/custom-manufacturing">
                        {t('home.manufacturing.cta')}
                        <Sparkles class="ml-2 h-5 w-5" />
                    </Link>
                </Button>
            </div>

            {/* Right Image */}
            <div class="relative fade-right opacity-0 translate-x-8 transition-all duration-700">
                <div class="relative rounded-2xl overflow-hidden glass group">
                    <img
                        src="/images/manufacturing.webp"
                        alt="Manufacturing Facility"
                        class="w-full h-auto transition-transform duration-700 group-hover:scale-105"
                        loading="lazy"
                    />

                    {/* Badge Overlay */}
                    <div class="absolute bottom-8 right-8 badge-pop opacity-0 scale-90 transition-all duration-700 delay-500">
                        <div class="glass-strong rounded-2xl p-6 text-center">
                            <Award class="w-8 h-8 text-[#B8FF00] mx-auto mb-2" />
                            <div class="text-3xl font-bold text-white mb-1">500+ Clients</div>
                            <div class="text-sm text-gray-400">15+ Year</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<script>
    const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
            if (entry.isIntersecting) {
                entry.target.querySelectorAll('.fade-up, .fade-left, .fade-right, .fade-in, .badge-pop').forEach(el => {
                    el.classList.remove('opacity-0', 'translate-y-4', '-translate-x-8', 'translate-x-8', 'scale-90');
                    el.classList.add('opacity-100', 'translate-y-0', 'translate-x-0', 'scale-100');
                });
                observer.unobserve(entry.target);
            }
        });
    }, { threshold: 0.1 });

    const section = document.getElementById('manufacturing-section');
    if (section) {
        observer.observe(section);
    }
</script>

<style>
    .fade-up, .fade-left, .fade-right, .fade-in, .badge-pop {
        transition-property: transform, opacity;
    }
</style>
