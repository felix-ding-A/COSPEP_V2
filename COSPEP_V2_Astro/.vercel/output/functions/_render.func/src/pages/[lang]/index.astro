---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { useTranslations } from '../../lib/i18n';

export function getStaticPaths() {
  return [
    { params: { lang: 'en' } },
    { params: { lang: 'es' } },
    { params: { lang: 'ru' } },
    { params: { lang: 'ar' } },
  ];
}

const { lang } = Astro.params;
const t = useTranslations(lang as any);

const title = t('common.home') + " | COSPEP";
---

<BaseLayout title={title}>
	<main class="flex min-h-screen flex-col items-center justify-center p-24">
		<div class="relative flex flex-col items-center mt-12 mb-12 text-center">
			<h1 class="text-6xl font-bold bg-clip-text text-transparent bg-gradient-to-r from-[#B8FF00] to-white mb-4">
				{t('home.hero.slides.0.title')} {t('home.hero.slides.0.highlight')}
			</h1>
            <p class="text-xl text-gray-400 max-w-2xl">
                {t('home.hero.slides.0.description')}
            </p>
            <div class="mt-8 flex gap-4">
                <button class="bg-[#B8FF00] text-black px-8 py-3 rounded-full font-bold hover:scale-105 transition-transform">
                    {t('common.learnMore')}
                </button>
                <button class="border border-white/20 px-8 py-3 rounded-full font-bold hover:bg-white/5 transition-colors">
                    {t('common.contact')}
                </button>
            </div>
		</div>

        <section class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mt-12 w-full max-w-6xl">
            {['cgmp', 'fda', 'tested', 'shipping'].map((key) => (
                <div class="glass p-6 rounded-2xl border border-white/10">
                    <h3 class="text-[#B8FF00] font-bold text-xl mb-1">{t(`home.stats.${key}.label`)}</h3>
                    <p class="text-gray-400 text-sm">{t(`home.stats.${key}.description`)}</p>
                </div>
            ))}
        </section>

        <div class="mt-12 text-sm text-gray-500">
            Current Language: <span class="text-[#B8FF00] uppercase font-bold">{lang}</span>
            <div class="mt-2 flex gap-4 justify-center">
                <a href="/" class="hover:text-white">EN</a>
                <a href="/es" class="hover:text-white">ES</a>
                <a href="/ru" class="hover:text-white">RU</a>
                <a href="/ar" class="hover:text-white">AR</a>
            </div>
        </div>
	</main>
</BaseLayout>
