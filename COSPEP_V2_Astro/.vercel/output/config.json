{
	"version": 3,
	"routes": [
		{
			"handle": "filesystem"
		},
		{
			"src": "^/_astro/(.*)$",
			"headers": {
				"cache-control": "public, max-age=31536000, immutable"
			},
			"continue": true
		},
		{
			"src": "^/_server-islands/([^/]+?)/?$",
			"dest": "_render"
		},
		{
			"src": "^/_image/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/submit-inquiry/?$",
			"dest": "_render"
		},
		{
			"src": "^/([^/]+?)/?$",
			"dest": "_render"
		},
		{
			"src": "^(?:/(.*?))?/about/?$",
			"dest": "_render"
		},
		{
			"src": "^(?:/(.*?))?/contact/?$",
			"dest": "_render"
		},
		{
			"src": "^(?:/(.*?))?/custom-manufacturing/?$",
			"dest": "_render"
		},
		{
			"src": "^(?:/(.*?))?/industry-insights/([^/]+?)/?$",
			"dest": "_render"
		},
		{
			"src": "^(?:/(.*?))?/industry-insights/?$",
			"dest": "_render"
		},
		{
			"src": "^(?:/(.*?))?/privacy/?$",
			"dest": "_render"
		},
		{
			"src": "^(?:/(.*?))?/products/([^/]+?)/?$",
			"dest": "_render"
		},
		{
			"src": "^(?:/(.*?))?/products/?$",
			"dest": "_render"
		},
		{
			"src": "^(?:/(.*?))?/resources/sustainability/?$",
			"dest": "_render"
		},
		{
			"src": "^(?:/(.*?))?/search/?$",
			"dest": "_render"
		},
		{
			"src": "^(?:/(.*?))?/service/?$",
			"dest": "_render"
		},
		{
			"src": "^(?:/(.*?))?/services/after-sales-support/?$",
			"dest": "_render"
		},
		{
			"src": "^(?:/(.*?))?/services/packaging-logistics/?$",
			"dest": "_render"
		},
		{
			"src": "^(?:/(.*?))?/terms/?$",
			"dest": "_render"
		},
		{
			"src": "^(?:/(.*?))?/?$",
			"dest": "_render"
		},
		{
			"src": "^/404/?$",
			"dest": "_render"
		},
		{
			"src": "^/.*$",
			"dest": "_render",
			"status": 404
		}
	]
}